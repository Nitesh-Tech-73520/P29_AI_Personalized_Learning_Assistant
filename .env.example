# Choose mysql or sqlite. SQLite is easiest for first-time testing.
DB_TYPE=mysql

# MySQL settings (used when DB_TYPE=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=YOUR_MYSQL_PASSWORD
MYSQL_DATABASE=ai_learning_assistant

# Security: change this to a long random value before deployment
SECRET_KEY=replace-with-a-long-random-secret

# Optional local paths
# SQLITE_PATH=instance/ai_learning_assistant.db
# UPLOAD_FOLDER=uploads
